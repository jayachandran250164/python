class StackNode:
    def __init__(self, url):
        self.url = url
        self.next = None


class StackHistory:
    def __init__(self):
        self.top = None

    def push(self, url):
        new = StackNode(url)
        new.next = self.top
        self.top = new

    def pop(self):
        if self.top is None:
            return None

        url = self.top.url
        self.top = self.top.next
        return url


# Create browser history
history = StackHistory()

history.push("google.com")
history.push("openai.com")
history.push("github.com")

print("Last visited:", history.pop())
